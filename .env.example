# AdBazaar settings. Copy this file to ".env" and change the values.
# (On Windows, windows\1-setup.bat does the copy and opens it in Notepad.)

# ---- 1. Your admin (owner) login — created the first time the app starts ----
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-this-to-a-long-password

# ---- 2. Port — pick one no other program uses (4780 is rarely taken) ----
PORT=4780

# ---- 3. Addresses ----
# "auto" works for this computer (localhost), your Wi-Fi (192.168.x.x) AND your
# Cloudflare Tunnel domain at the same time - you don't need to change it.
COOKIE_SECURE=auto
TRUST_PROXY=0
# After you set up Cloudflare Tunnel, put your domain here (no / at the end).
# Video-call links sent to clients use it, so their camera works (needs https).
# BASE_URL=https://test.yourdomain.com

# Storage (database + uploaded files). Back this folder up!
# STORAGE_DIR=./storage
# DATABASE_FILE=./storage/adbazaar.db
MAX_UPLOAD_MB=30

# ---- Payments ----
# Manual UPI (always available): set your UPI ID here or in Admin → Settings
UPI_ID=yourname@okhdfcbank
UPI_PAYEE_NAME=Your Business Name

# Razorpay (optional): instant online payments — ad goes live automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to configure in Razorpay dashboard: https://yourdomain/webhooks/razorpay  (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---- KYC video call ----
# Public STUN works for most users. Add a TURN server (e.g. coturn, Metered, Twilio) for users behind strict mobile networks.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.yourdomain.com:3478
# TURN_USERNAME=
# TURN_PASSWORD=

# How often (minutes) ads are re-ranked and expired ads removed
SCHEDULER_MINUTES=5
